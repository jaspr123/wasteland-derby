{
  "name": "wasteland-derby",
  "private": true,
  "version": "0.1.0",
  "description": "Wasteland Derby \u2014 bet on armed horse races in a post-apocalyptic racecourse. Multiplayer, 3D, in the browser.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev -w @derby/server\" \"npm:dev -w @derby/client\"",
    "build": "npm run build -w @derby/client && npm run build -w @derby/server",
    "start": "npm run start -w @derby/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "assets:build": "blender -b --factory-startup -P tools/blender/build_runners.py -- .",
    "assets:optimize": "node tools/asset-pipeline/optimize-assets.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2"
  }
}
